/*
 * Targov v3.0 — Professional Dark Theme
 * مُلهم من تصميم Bybit
 */

/* ═══════════════════════════════════════════
   المتغيرات العامة (تُقرأ من بايثون)
   ═══════════════════════════════════════════ */

/* ═══════════════════════════════════════════
   النافذة الرئيسية
   ═══════════════════════════════════════════ */
QMainWindow {
    background-color: #0b0e11;
}

QWidget {
    background-color: #0b0e11;
    color: #eaecef;
    font-family: "Segoe UI", "Helvetica Neue", "Consolas", sans-serif;
    font-size: 12px;
}

/* ═══════════════════════════════════════════
   شريط التنقل العلوي
   ═══════════════════════════════════════════ */
#topNav {
    background-color: #0b0e11;
    border-bottom: 1px solid #1e2329;
}

#logo {
    font-size: 22px;
    font-weight: 900;
    color: #f0a500;
    padding: 0 8px;
    background-color: #1e2329;
    border-radius: 6px;
    min-width: 32px;
    max-width: 32px;
    qproperty-alignment: AlignCenter;
}

#lblbalance {
    color: #848e9c;
    font-size: 12px;
    font-weight: 600;
    font-family: "Consolas", "SF Mono", monospace;
}

/* ═══════════════════════════════════════════
   شريط التيكر
   ═══════════════════════════════════════════ */
#tickerBar, QFrame#tickerBar {
    background-color: #0b0e11;
    border-bottom: 1px solid #1e2329;
}

#tickerPair {
    font-size: 15px;
    font-weight: 700;
    color: #eaecef;
}

#tickerPrice {
    font-size: 14px;
    font-weight: 700;
    color: #eaecef;
    font-family: "Consolas", "SF Mono", monospace;
}

#tickerCaption {
    font-size: 10px;
    color: #555b65;
    margin-left: 4px;
}

#tickerChange {
    font-size: 14px;
    font-weight: 700;
    font-family: "Consolas", "SF Mono", monospace;
}

#tickerHigh, #tickerLow {
    font-size: 13px;
    font-weight: 600;
    color: #eaecef;
    font-family: "Consolas", "SF Mono", monospace;
}

#tickerVolume {
    font-size: 13px;
    font-weight: 600;
    color: #eaecef;
    font-family: "Consolas", "SF Mono", monospace;
}

/* ═══════════════════════════════════════════
   شريط الحالة السفلي
   ═══════════════════════════════════════════ */
#statusBar {
    background-color: #0b0e11;
    border-top: 1px solid #1e2329;
}

#statusText {
    color: #0ecb81;
    font-size: 11px;
    font-weight: 600;
}

#latencyLabel, #uptimeLabel {
    color: #555b65;
    font-size: 11px;
    font-family: "Consolas", "SF Mono", monospace;
}

#settingsIcon {
    font-size: 16px;
    color: #848e9c;
    padding: 0 4px;
}

#settingsIcon:hover {
    color: #f0a500;
}

/* ═══════════════════════════════════════════
   شريط أدوات الشارت
   ═══════════════════════════════════════════ */
#chartToolbar {
    background-color: #0b0e11;
    border-bottom: 1px solid #1e2329;
}

QPushButton#tfButton {
    background-color: transparent;
    color: #848e9c;
    border: none;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
    font-family: "Consolas", monospace;
}

QPushButton#tfButton:hover {
    color: #eaecef;
    background-color: #1e2329;
}

QPushButton#tfButton:checked {
    color: #f0a500;
    background-color: #1e2329;
}

QPushButton#chartTypeButton {
    background-color: transparent;
    color: #848e9c;
    border: none;
    border-radius: 4px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#chartTypeButton:hover {
    color: #eaecef;
    background-color: #1e2329;
}

QPushButton#chartTypeButton:checked {
    color: #f0a500;
    background-color: #1e2329;
}

QPushButton#fitButton {
    background-color: transparent;
    color: #848e9c;
    border: 1px solid #2b3139;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#fitButton:hover {
    border-color: #f0a500;
    color: #f0a500;
}

/* ═══════════════════════════════════════════
   لوحات Dock
   ═══════════════════════════════════════════ */
QDockWidget {
    color: #eaecef;
    font-weight: 600;
    font-size: 12px;
    titlebar-close-icon: none;
}

QDockWidget::title {
    background-color: #1e2329;
    padding: 8px 12px;
    border-bottom: 1px solid #2b3139;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    color: #eaecef;
}

QDockWidget::close-button {
    icon-size: 14px;
    subcontrol-position: top right;
    subcontrol-origin: padding;
    padding: 4px;
}

QDockWidget::close-button:hover {
    background-color: #f6465d;
    border-radius: 3px;
}

QDockWidget QWidget {
    background-color: #0b0e11;
}

/* ═══════════════════════════════════════════
   الجداول
   ═══════════════════════════════════════════ */
QTableView, QTableWidget {
    background-color: #0b0e11;
    alternate-background-color: #12161c;
    color: #eaecef;
    gridline-color: #1e2329;
    border: none;
    selection-background-color: #1e2329;
    selection-color: #f0a500;
    font-size: 11px;
    font-family: "Consolas", "SF Mono", monospace;
}

QTableView::item, QTableWidget::item {
    padding: 4px 8px;
}

QTableView::item:hover, QTableWidget::item:hover {
    background-color: #1e2329;
}

QHeaderView::section {
    background-color: #0b0e11;
    color: #555b65;
    border: none;
    border-bottom: 1px solid #1e2329;
    padding: 6px 8px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
}

/* ═══════════════════════════════════════════
   حقول الإدخال والأزرار
   ═══════════════════════════════════════════ */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #1e2329;
    color: #eaecef;
    border: 1px solid #2b3139;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    font-family: "Consolas", "SF Mono", monospace;
    selection-background-color: #f0a500;
    selection-color: #0b0e11;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #f0a500;
}

QDoubleSpinBox, QSpinBox {
    background-color: #1e2329;
    color: #eaecef;
    border: 1px solid #2b3139;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 600;
    font-family: "Consolas", "SF Mono", monospace;
}

QDoubleSpinBox:focus, QSpinBox:focus {
    border: 1px solid #f0a500;
}

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button {
    width: 0px;
    border: none;
}

QComboBox {
    background-color: #1e2329;
    color: #eaecef;
    border: 1px solid #2b3139;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    font-family: "Consolas", "SF Mono", monospace;
}

QComboBox:focus {
    border: 1px solid #f0a500;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #848e9c;
    width: 0;
    height: 0;
}

QComboBox QAbstractItemView {
    background-color: #1e2329;
    color: #eaecef;
    selection-background-color: #2b3139;
    selection-color: #f0a500;
    border: 1px solid #2b3139;
    border-radius: 6px;
    outline: none;
}

QCheckBox {
    color: #eaecef;
    spacing: 8px;
    font-size: 12px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #474d57;
    border-radius: 3px;
    background-color: #1e2329;
}

QCheckBox::indicator:checked {
    background-color: #f0a500;
    border-color: #f0a500;
}

QCheckBox::indicator:hover {
    border-color: #f0a500;
}

/* ═══════════════════════════════════════════
   الأزرار العامة
   ═══════════════════════════════════════════ */
QPushButton {
    background-color: #1e2329;
    color: #eaecef;
    border: 1px solid #2b3139;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton:hover {
    border-color: #f0a500;
    color: #f0a500;
}

QPushButton:pressed {
    background-color: #0b0e11;
}

QPushButton:disabled {
    background-color: #1e2329;
    color: #474d57;
    border-color: #1e2329;
}

/* ═══════════════════════════════════════════
   التبويبات
   ═══════════════════════════════════════════ */
QTabWidget::pane {
    border: 1px solid #2b3139;
    border-radius: 6px;
    background: #0b0e11;
}

QTabBar::tab {
    background: #1e2329;
    color: #848e9c;
    padding: 8px 18px;
    border: 1px solid #2b3139;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-size: 12px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background: #0b0e11;
    color: #f0a500;
    border-bottom: 2px solid #f0a500;
}

QTabBar::tab:hover:!selected {
    background: #2b3139;
    color: #eaecef;
}

/* ═══════════════════════════════════════════
   المجموعات (GroupBox)
   ═══════════════════════════════════════════ */
QGroupBox {
    border: 1px solid #2b3139;
    border-radius: 6px;
    margin-top: 12px;
    padding: 16px 12px 12px 12px;
    font-weight: 700;
    color: #eaecef;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 8px;
    color: #f0a500;
    font-size: 12px;
}

/* ═══════════════════════════════════════════
   شريط التمرير
   ═══════════════════════════════════════════ */
QScrollBar:vertical {
    background: #0b0e11;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #2b3139;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #474d57;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #0b0e11;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #2b3139;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #474d57;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ═══════════════════════════════════════════
   ToolBox (Advanced Settings)
   ═══════════════════════════════════════════ */
QToolBox {
    background-color: #0b0e11;
    border: 1px solid #2b3139;
    border-radius: 6px;
}

QToolBox::tab {
    background-color: #1e2329;
    color: #eaecef;
    border: 1px solid #2b3139;
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 600;
}

QToolBox::tab:selected {
    background-color: #2b3139;
    color: #f0a500;
    border-color: #f0a500;
}

QToolBox::tab:hover:!selected {
    background-color: #2b3139;
}

/* ═══════════════════════════════════════════
   Slider
   ═══════════════════════════════════════════ */
QSlider::groove:horizontal {
    background: #2b3139;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #f0a500;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #f5c040;
}

QSlider::sub-page:horizontal {
    background: #f0a500;
    border-radius: 2px;
}

/* ═══════════════════════════════════════════
   الخطوط الفاصلة
   ═══════════════════════════════════════════ */
QFrame[frameShape="4"] { /* HLine */
    color: #2b3139;
    max-height: 1px;
}

QFrame[frameShape="5"] { /* VLine */
    color: #2b3139;
    max-width: 1px;
}

/* ═══════════════════════════════════════════
   ToolTip
   ═══════════════════════════════════════════ */
QToolTip {
    background-color: #1e2329;
    color: #eaecef;
    border: 1px solid #f0a500;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 11px;
}

/* ═══════════════════════════════════════════
   القوائم
   ═══════════════════════════════════════════ */
QMenu {
    background-color: #1e2329;
    color: #eaecef;
    border: 1px solid #2b3139;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 28px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #2b3139;
    color: #f0a500;
}

QMenu::separator {
    height: 1px;
    background-color: #2b3139;
    margin: 4px 8px;
}

QMenuBar {
    background-color: #0b0e11;
    color: #eaecef;
    border-bottom: 1px solid #1e2329;
}

QMenuBar::item:selected {
    background-color: #1e2329;
    color: #f0a500;
}

/* ═══════════════════════════════════════════
   Dialog
   ═══════════════════════════════════════════ */
QDialog {
    background-color: #0b0e11;
}


/* ---------- Strategy Builder Dialog ---------- */
QDialog#StrategyBuilderDialog {
    background-color: #0b0e11;
}

/* Section Titles */
QLabel.sectionTitle {
    font-size: 15px;
    font-weight: bold;
    padding: 8px 0px 4px 0px;
}

/* Condition Row Combos */
QComboBox.conditionSource, QComboBox.conditionOperator {
    background-color: #0b0e11;
    color: #eaecef;
    border: 1px solid #2b3139;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

QComboBox.conditionSource:focus, QComboBox.conditionOperator:focus {
    border-color: #f0a500;
}

/* Indicator Card */
QFrame.indicatorCard {
    background-color: #161a1e;
    border: 1px solid #2b3139;
    border-left: 3px solid #f0a500;
    border-radius: 6px;
    padding: 12px;
    margin: 4px 0px;
}

/* Add Condition Buttons */
QPushButton.btnAddCondition {
    background-color: transparent;
    border: 1px dashed;
    border-radius: 4px;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton.btnAddCondition.buy {
    color: #0ecb81;
    border-color: #0ecb81;
}

QPushButton.btnAddCondition.buy:hover {
    background-color: #0ecb81;
    color: #0b0e11;
    border-style: solid;
}

QPushButton.btnAddCondition.sell {
    color: #f6465d;
    border-color: #f6465d;
}

QPushButton.btnAddCondition.sell:hover {
    background-color: #f6465d;
    color: #ffffff;
    border-style: solid;
}